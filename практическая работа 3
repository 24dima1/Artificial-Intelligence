from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout, BatchNormalization

# Определение архитектуры сверточной нейронной сети без смещений (bias)
model = Sequential([
    # Первый сверточный блок
    Conv2D(32, (3, 3), activation='relu', input_shape=x_train.shape[1:], padding='same', use_bias=False),
    BatchNormalization(),
    Conv2D(32, (3, 3), activation='relu', padding='same', use_bias=False),
    BatchNormalization(),
    MaxPooling2D((2, 2)),
    Dropout(0.25),

    # Второй сверточный блок
    Conv2D(64, (3, 3), activation='relu', padding='same', use_bias=False),
    BatchNormalization(),
    Conv2D(64, (3, 3), activation='relu', padding='same', use_bias=False),
    BatchNormalization(),
    MaxPooling2D((2, 2)),
    Dropout(0.25),

    # Третий сверточный блок (опционально, для более глубокой сети)
    Conv2D(128, (3, 3), activation='relu', padding='same', use_bias=False),
    BatchNormalization(),
    Conv2D(128, (3, 3), activation='relu', padding='same', use_bias=False),
    BatchNormalization(),
    MaxPooling2D((2, 2)),
    Dropout(0.25),

    # Выравнивание и полносвязные слои
    Flatten(),
    Dense(512, activation='relu', use_bias=False),
    BatchNormalization(),
    Dropout(0.5),
    Dense(num_classes, activation='softmax', use_bias=False)
])

# Вывод сводки модели
model.summary()

